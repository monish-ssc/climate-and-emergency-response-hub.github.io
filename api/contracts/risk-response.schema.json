{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climateguard.example/schemas/risk-response.schema.json",
  "title": "Risk assessment response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "region", "hazard", "assessment", "sources", "dataMode", "generatedAt"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "hazard": { "$ref": "common.schema.json#/$defs/hazardType" },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "summary", "factors"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/riskFactor" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/source" }
    },
    "dataMode": { "$ref": "common.schema.json#/$defs/dataMode" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string" }
  }
}
